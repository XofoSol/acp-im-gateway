# acp-im-gateway — example configuration.
#
# Copy to `.env` (git-ignored) and fill in your own values. Every value here is a
# placeholder: nothing in the code names a real person, path, chat or token.
#
# Precedence: built-in defaults  <  TOML config file  <  environment / .env  <  CLI flags.

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Bot token from @BotFather. REQUIRED to run the gateway.
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_YOUR_BOT_TOKEN

# Optional: override the Bot API base URL (tests / local Bot API server).
# TELEGRAM_API_BASE=https://api.telegram.org

# Comma-separated numeric Telegram user ids allowed to drive the gateway.
# DENY BY DEFAULT: an empty list means nobody is allowed except users you pair.
ALLOWED_USER_IDS=

# Comma-separated chat ids allowed to drive the gateway *in groups*.
# Empty = direct messages only (group traffic is refused).
ALLOWED_CHAT_IDS=

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Root scanned for project candidates (directories containing .git).
PROJECTS_ROOT=~/Projects

# Comma-separated roots a chat may bind a directory inside. Empty = PROJECTS_ROOT.
# Containment is enforced with os.path.realpath, so symlink escapes are rejected.
ALLOWED_ROOTS=

# Where the agent keeps its own project index (used as discovery hints; optional).
REASONIX_PROJECTS_DIR=~/.reasonix/projects

# Gateway state (bindings, polling offset, allowlist, pairing codes). Keep it out of git.
GATEWAY_STATE_FILE=~/.local/state/acp-im-gateway/state.json

# Optional TOML config file. Defaults to ~/.config/acp-im-gateway/config.toml when present.
# GATEWAY_CONFIG=

# Optional .env file. Defaults to ./.env when present.
# GATEWAY_ENV_FILE=

# ---------------------------------------------------------------------------
# Agent
# ---------------------------------------------------------------------------

# Command used to speak ACP over stdio. Any ACP-speaking agent works.
REASONIX_ACP_CMD=reasonix acp

# Wall-clock cap for one turn, seconds. 0 = no cap (a turn ends on its own stop reason).
GATEWAY_TURN_TIMEOUT=0

# Max seconds between agent respawn attempts (exponential backoff up to this).
GATEWAY_RESTART_BACKOFF_MAX=30

# ---------------------------------------------------------------------------
# Runtime behaviour
# ---------------------------------------------------------------------------

# Minimum seconds between edits of the streaming message (default 1.2).
GATEWAY_EDIT_INTERVAL=1.2

# Minimum seconds between new outgoing messages per chat (rate limit, default 1.0).
GATEWAY_SEND_INTERVAL=1.0

# getUpdates long-poll timeout in seconds.
GATEWAY_POLL_TIMEOUT=30

# What to do with a message that arrives mid-turn: steer | queue.
# `steer` is used only when the agent advertises session steering; otherwise it queues.
GATEWAY_BUSY_MODE=steer

# How long a pairing code stays valid, seconds.
GATEWAY_PAIRING_TTL=900

# How long an unanswered approval stays pending, seconds.
GATEWAY_APPROVAL_TIMEOUT=300

# Tool-approval posture to request from the agent: ask | auto | yolo.
# Empty means "leave whatever the agent is configured with".
GATEWAY_APPROVAL_POSTURE=ask

# How deep to scan PROJECTS_ROOT for directories containing .git.
GATEWAY_DISCOVERY_DEPTH=1

# DEBUG | INFO | WARNING | ERROR
GATEWAY_LOG_LEVEL=INFO

# Print what would be sent to Telegram instead of calling the network.
GATEWAY_DRY_RUN=0
